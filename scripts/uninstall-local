#!/usr/bin/env bash
set -euo pipefail

install_dir="${NINAI_INSTALL_DIR:-${HOME}/.ninai-app}"
data_dir="${NINAI_DATA_DIR:-${HOME}/.ninai}"

for target in "${install_dir}" "${data_dir}"; do
  case "${target}" in
    /*) ;;
    *) printf 'Refusing non-absolute uninstall target: %s\n' "${target}" >&2; exit 2 ;;
  esac
  if [[ "${target}" == "/" || "${target}" == "${HOME}" ]]; then
    printf 'Refusing broad uninstall target: %s\n' "${target}" >&2
    exit 2
  fi
done

printf '%s\n' 'Removing Ninai connections and hooks…'
pkill -f "${install_dir}/Ninai.app/Contents/MacOS/Ninai" >/dev/null 2>&1 || true

python_cmd=""
if [[ -x "${install_dir}/venv/bin/python" ]]; then
  python_cmd="${install_dir}/venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  python_cmd="$(command -v python3)"
fi

cli_entry_owned() {
  NINAI_INSTALL_DIR="${install_dir}" "${python_cmd}" - "$1" "$2" <<'PY'
import json
import os
import sys
from pathlib import Path
import tomllib

client, name = sys.argv[1:]
try:
    if client == "claude":
        path = Path(os.environ["CLAUDE_CONFIG_DIR"]) / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR") else Path.home() / ".claude.json"
        if path.is_symlink():
            raise ValueError("Linked configuration needs manual review")
        data = json.loads(path.read_text())
        entry = data.get("mcpServers", {}).get(name, {})
    else:
        path = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "config.toml"
        if path.is_symlink():
            raise ValueError("Linked configuration needs manual review")
        data = tomllib.loads(path.read_text())
        entry = data.get("mcp_servers", {}).get(name, {})
    owned = isinstance(entry, dict) and entry.get("command") == os.environ["NINAI_INSTALL_DIR"] + "/venv/bin/ninai-mcp"
except (OSError, ValueError, AttributeError, TypeError):
    owned = False
raise SystemExit(0 if owned else 1)
PY
}

if [[ -n "${python_cmd}" ]]; then
  if command -v claude >/dev/null 2>&1; then
    for name in ninai-local ninai; do
      if cli_entry_owned claude "${name}"; then claude mcp remove "${name}" --scope user >/dev/null 2>&1 || true; fi
    done
  fi
  if command -v codex >/dev/null 2>&1 && cli_entry_owned codex ninai-local; then
    codex mcp remove ninai-local >/dev/null 2>&1 || true
  fi
  if [[ -x "${install_dir}/venv/bin/ninai-connect" ]]; then
    for editor in cursor vscode; do
      "${install_dir}/venv/bin/ninai-connect" "${editor}" --command "${install_dir}/venv/bin/ninai-mcp" --remove || \
        printf 'Kept %s settings unchanged; review the Ninai entry in the editor.\n' "${editor}" >&2
    done
  fi
  NINAI_INSTALL_DIR="${install_dir}" "${python_cmd}" - <<'PY'
import json
import os
import shlex
import stat
from pathlib import Path

install_dir = os.environ["NINAI_INSTALL_DIR"]
gemini_settings = Path.home() / ".gemini" / "settings.json"
if gemini_settings.exists() and not gemini_settings.is_symlink():
    try:
        data = json.loads(gemini_settings.read_text())
        servers = data.get("mcpServers") if isinstance(data, dict) else None
        entry = servers.get("ninai-local") if isinstance(servers, dict) else None
        if isinstance(entry, dict) and entry.get("command") == install_dir + "/venv/bin/ninai-mcp":
            del servers["ninai-local"]
            mode = stat.S_IMODE(gemini_settings.stat().st_mode)
            temporary = gemini_settings.with_name(gemini_settings.name + ".ninai-uninstall.tmp")
            temporary.write_text(json.dumps(data, indent=2) + "\n")
            os.chmod(temporary, mode)
            os.replace(temporary, gemini_settings)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Kept {gemini_settings} unchanged because it could not be safely read: {exc}")

targets = (Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))) / "settings.json",
           Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "hooks.json")

def owned_hook(command):
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    if words[:1] == ["env"]:
        words = words[1:]
        while words and "=" in words[0] and not words[0].startswith("-"):
            words = words[1:]
    return len(words) >= 2 and words[0] == install_dir + "/venv/bin/ninai" and words[1] in {"session-hook", "capture-hook"}

for path in targets:
    if not path.exists() or path.is_symlink():
        continue
    try:
        original = path.read_text()
        data = json.loads(original)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Kept {path} unchanged because it could not be safely read: {exc}")
        continue
    hooks = data.get("hooks") if isinstance(data, dict) else None
    if not isinstance(hooks, dict):
        continue
    changed = False
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                kept_groups.append(group)
                continue
            kept_hooks = []
            for item in group["hooks"]:
                command = str(item.get("command", "")) if isinstance(item, dict) else ""
                is_ninai = owned_hook(command)
                if is_ninai:
                    changed = True
                else:
                    kept_hooks.append(item)
            if kept_hooks:
                updated = dict(group)
                updated["hooks"] = kept_hooks
                kept_groups.append(updated)
            elif group["hooks"]:
                changed = True
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if changed:
        mode = stat.S_IMODE(path.stat().st_mode)
        temporary = path.with_name(path.name + ".ninai-uninstall.tmp")
        temporary.write_text(json.dumps(data, indent=2) + "\n")
        os.chmod(temporary, mode)
        os.replace(temporary, path)
PY
fi

timestamp="$(date +%Y%m%d-%H%M%S)"
trash_root="${HOME}/.Trash/Ninai-uninstall-${timestamp}"
mkdir -m 700 -p "${trash_root}"

moved=0
if [[ -d "${install_dir}" ]]; then
  mv "${install_dir}" "${trash_root}/ninai-app"
  moved=1
fi
if [[ -d "${data_dir}" ]]; then
  mv "${data_dir}" "${trash_root}/ninai-data"
  moved=1
fi

if [[ "${moved}" -eq 1 ]]; then
  printf 'Ninai was uninstalled. A recoverable copy is in:\n  %s\n' "${trash_root}"
else
  rmdir "${trash_root}" 2>/dev/null || true
  printf '%s\n' 'Ninai was already uninstalled.'
fi
