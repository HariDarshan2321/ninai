#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $# -eq 0 ]]; then
  printf '%s\n' 'Provide capture.json from a real product walkthrough. Text-card concept videos are no longer generated.' >&2
  exit 2
fi
exec python3 "${repo_root}/scripts/build-install-walkthrough.py" "$@"
