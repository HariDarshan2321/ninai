# Hosted mode is opt-in and never reads or uploads the local SQLite vault.
DATABASE_URL=postgresql://ninai:change-me@localhost:5432/ninai
NINAI_DATABASE_POOL_MIN_SIZE=1
NINAI_DATABASE_POOL_MAX_SIZE=10
HOST=127.0.0.1
PORT=8000

# Ninai validates access tokens from this external OAuth/OIDC issuer. It does
# not store passwords or issue tokens itself.
NINAI_OAUTH_ISSUER=https://auth.example.com
NINAI_OAUTH_AUDIENCE=ninai-cloud
NINAI_OAUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
NINAI_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/oauth2/authorize
NINAI_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/oauth2/token
NINAI_PUBLIC_RESOURCE_URL=https://api.example.com/mcp
NINAI_OAUTH_WORKSPACE_CLAIM=ninai_workspace_id
NINAI_OAUTH_CLIENT_CONNECTION_CLAIM=ninai_client_connection_id
