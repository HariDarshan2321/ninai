# Hosted mode is opt-in and never reads or uploads the local SQLite vault.
DATABASE_URL=postgresql://ninai:change-me@localhost:5432/ninai
NINAI_DATABASE_POOL_MIN_SIZE=1
NINAI_DATABASE_POOL_MAX_SIZE=10
HOST=127.0.0.1
PORT=8000

# Authentication defaults to OAuth. Set this explicitly to "pat" only for a
# trusted self-hosted deployment; PAT mode does not require an OAuth issuer.
NINAI_AUTH_MODE=oauth

# Ninai validates access tokens from this external OAuth/OIDC issuer. It does
# not store passwords or issue tokens itself.
NINAI_OAUTH_ISSUER=https://YOUR_TENANT.REGION.auth0.com/
NINAI_OAUTH_AUDIENCE=https://api.example.com/mcp
NINAI_OAUTH_JWKS_URI=https://YOUR_TENANT.REGION.auth0.com/.well-known/jwks.json
NINAI_OAUTH_AUTHORIZATION_ENDPOINT=https://YOUR_TENANT.REGION.auth0.com/authorize
NINAI_OAUTH_TOKEN_ENDPOINT=https://YOUR_TENANT.REGION.auth0.com/oauth/token
NINAI_PUBLIC_RESOURCE_URL=https://api.example.com/mcp
NINAI_OAUTH_WORKSPACE_CLAIM=https://ninai.io/workspace_id
NINAI_OAUTH_CLIENT_ID_CLAIM=client_id
